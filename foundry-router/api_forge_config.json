{
  "name": "Meta Foundry Router v1 - API forge",
  "note": "Generated from src/router.js by scripts/sync-config.mjs. Model IDs drift; the router heals them via GET /models.",
  "protocol": "OpenAI-compatible POST {baseUrl}/chat/completions, stream:true, SSE \"data:\" lines (Anthropic: /messages)",
  "backoff": {
    "baseMs": 500,
    "capMs": 8000,
    "maxRetriesPerProvider": 2,
    "retryOn": [
      429,
      500,
      502,
      503,
      504
    ],
    "formula": "min(cap, max(base * 2^n, Retry-After))"
  },
  "failover": {
    "on": [
      "401/403 auth",
      "network/CORS",
      "model gone after heal attempt",
      "retries exhausted",
      "local rpm window full",
      "no key"
    ],
    "neverAfterPartialOutput": true
  },
  "eyeGates": {
    "batteryPct": 15,
    "thermalC": 70,
    "action": "force WebLLM offline only"
  },
  "fallbackChain": [
    {
      "id": "groq",
      "label": "Groq",
      "kind": "openai",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "model": "llama-3.3-70b-versatile",
      "prefs": [
        "llama-3\\.3-70b",
        "llama-3\\.1-8b",
        "llama"
      ],
      "rpm": 30,
      "free": "30 req/min free · ~300 tok/s (Groq = LPU chip company, not Grok)",
      "keyUrl": "https://console.groq.com/keys",
      "enabledByDefault": true
    },
    {
      "id": "cerebras",
      "label": "Cerebras",
