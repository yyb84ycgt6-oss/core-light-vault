# Foundry Router - local key vault shape.
# Copy to .env.local for local dev only. VITE_* values are inlined into the JS bundle
# at build time, so never build/deploy a public site with real keys in here.
# The in-app vault (Router tab) stores keys in localStorage instead and only sends
# each key to its own provider.

# Groq - https://api.groq.com/openai/v1 - 30 req/min free · ~300 tok/s (Groq = LPU chip company, not Grok) - https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Cerebras - https://api.cerebras.ai/v1 - 14k req/day free · ~1800 tok/s - https://cloud.cerebras.ai
VITE_CEREBRAS_API_KEY=

# Gemini - https://generativelanguage.googleapis.com/v1beta/openai - 1M tokens/day free tier (1.5-flash is retired; 2.x flash used) - https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter - https://openrouter.ai/api/v1 - :free models · 20 req/min · sends HTTP-Referer + X-Title - https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Together - https://api.together.xyz/v1 - $5 starter credit · llama-3 / mixtral - https://api.together.xyz/settings/api-keys
VITE_TOGETHER_API_KEY=

# Fireworks - https://api.fireworks.ai/inference/v1 - $5 starter credit - https://fireworks.ai/account/api-keys
VITE_FIREWORKS_API_KEY=

# DeepInfra - https://api.deepinfra.com/v1/openai - $5 starter credit - https://deepinfra.com/dash/api_keys
VITE_DEEPINFRA_API_KEY=

# xAI - https://api.x.ai/v1 - $5 credit · Grok = xAI model (not Groq) - https://console.x.ai
VITE_XAI_API_KEY=

# Anthropic - https://api.anthropic.com/v1 - $5 credit · Haiku tier (claude-3-5-haiku is retired) - https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# OpenAI - https://api.openai.com/v1 - $5 credit · gpt-4o-mini - https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Hugging Face - https://router.huggingface.co/v1 - Rate-limited free credits (api-inference is now the Inference Providers router) - https://huggingface.co/settings/tokens
VITE_HF_TOKEN=

# Mistral - https://api.mistral.ai/v1 - Free experiment tier - https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=

# Cohere - https://api.cohere.ai/compatibility/v1 - Trial key · OpenAI compatibility endpoint - https://dashboard.cohere.com/api-keys
VITE_COHERE_API_KEY=

# Anyscale - https://api.endpoints.anyscale.com/v1 - Anyscale Endpoints was shut down (2024); kept for completeness, off by default
VITE_ANYSCALE_API_KEY=

# Ollama needs no key. Override the base URL to reach it through a tunnel:
# ngrok http 11434   or   cloudflared tunnel --url http://localhost:11434
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1

# iPhone Runner companion (llama.cpp + Metal, docs/RUNNER_CONTRACT.md). Same device:
# http://localhost:8080/v1 · LAN: http://192.168.x.x:8080/v1 · https tunnel recommended.
VITE_RUNNER_BASE_URL=http://localhost:8080/v1
